@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency (PkgConfig)

pkg_search_module (FFTW3F fftw3f IMPORTED_TARGET)
pkg_search_module (LIBUSB libusb-1.0 IMPORTED_TARGET)
pkg_search_module (RTL_SDR librtlsdr IMPORTED_TARGET)

find_library(FAAD2_LIBRARIES NAMES faad_hdc)

if (NOT TARGET fftw3f)
    add_library(fftw3f ALIAS PkgConfig::FFTW3F)
endif()

if (NOT TARGET libusb)
    add_library(libusb ALIAS PkgConfig::LIBUSB)
endif()

if (NOT TARGET rtlsdr)
    add_library(rtlsdr ALIAS PkgConfig::RTL_SDR)
endif()

if (NOT TARGET faad2)
    add_library(faad2 INTERFACE IMPORTED)
    set_target_properties(faad2 PROPERTIES
            INTERFACE_LINK_LIBRARIES "${FAAD2_LIBRARIES}"
    )
endif()

include ("${CMAKE_CURRENT_LIST_DIR}/nrsc5Targets.cmake")
